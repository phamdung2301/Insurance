# Copy file này thành ".env" ở THƯ MỤC GỐC dự án (ngang hàng pom.xml), rồi điền giá trị thật.
# File .env KHÔNG commit lên git (đã có trong .gitignore).
# Thứ tự ưu tiên: biến môi trường OS ($env:) > .env > giá trị mặc định trong application.properties

# --- MongoDB ---
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=insuranceass

# --- JWT (tạo secret mới 256-bit, VD chạy: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 })) ) ---
# QUAN TRỌNG: secret cũ từng nằm trong repo public -> coi như đã lộ, BẮT BUỘC tạo mới.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
ADMIN_EMAILS=dungphdse@gmail.com,admin@insurtech.vn

# --- Gmail SMTP (đăng nhập OTP qua email) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173

# --- Dev Quick Switch (1 = bật tab "Đăng nhập dev" không cần OTP) ---
DEV_QUICK_SWITCH=false

# --- Khác ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
